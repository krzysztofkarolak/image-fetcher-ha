{% import '_macros.svg.twig' as ui %}

{% set weather_icons = {
  'sunny': 'weather-sunny', 'clear-night': 'weather-night', 'partlycloudy': 'weather-partly-cloudy',
  'cloudy': 'weather-cloudy', 'rainy': 'weather-rainy', 'pouring': 'weather-pouring',
  'snowy': 'weather-snowy', 'snowy-rainy': 'weather-snowy-rainy', 'fog': 'weather-fog',
  'windy': 'weather-windy', 'lightning': 'weather-lightning', 'lightning-rainy': 'weather-lightning-rainy',
  'hail': 'weather-hail'
} %}
{% set windows = d.windows_open is iterable ? d.windows_open : [] %}
{% set t_out = d.temp_out + 0 %}

<svg xmlns="http://www.w3.org/2000/svg" width="{{ w }}" height="{{ h }}" viewBox="0 0 {{ w }} {{ h }}"
     shape-rendering="crispEdges" text-rendering="geometricPrecision">
  <rect width="{{ w }}" height="{{ h }}" fill="{{ c.white }}"/>

  {{ ui.header(c, {w: w, title: vars.title, right: d.date ? d.date|date('l, F j') : ''}) }}

  {# Weather #}
  {% set t_color = t_out <= 0 ? c.blue : (t_out >= 28 ? c.red : c.black) %}
  {{ icon(weather_icons[d.weather] ?? 'weather-cloudy', 24, 84, 110, t_out >= 28 ? c.red : c.black) }}
  <text x="150" y="180" font-family="Inter, 'DejaVu Sans', sans-serif" font-weight="800" font-size="96" fill="{{ t_color }}">{{ d.temp_out|num }}°</text>
  <text x="152" y="214" font-family="Inter, 'DejaVu Sans', sans-serif" font-weight="500" font-size="22" fill="{{ c.black }}">outside · high {{ d.temp_max|num }}°</text>

  {# Indoor #}
  {{ ui.tile(c, {x: 400, y: 80, w: 190, h: 150, label: 'Living room', lsize: 20, icon: 'sofa',
                 value: d.temp_in|num(1), unit: '°', sub: d.hum_in|num ~ '% humidity'}) }}
  {{ ui.tile(c, {x: 594, y: 80, w: 190, h: 150, label: 'Bedroom', icon: 'bed',
                 value: d.temp_bed|num(1), unit: '°',
                 accent: (d.temp_bed + 0) > 22 ? c.red : c.black}) }}

  {# Energy #}
  {{ ui.tile(c, {x: 16, y: 246, w: 250, h: 120, label: 'Power', icon: 'flash', vsize: 52,
                 value: d.power_kw|num(1), unit: 'kW', accent: (d.power_kw + 0) >= 5 ? c.red : c.black,
                 alert: (d.power_kw + 0) >= 8}) }}
  {{ ui.tile(c, {x: 16, y: 370, w: 250, h: 96, label: 'Today', icon: 'chart-bar', vsize: 34,
                 value: d.energy_today|num, unit: 'kWh'}) }}

  {# Status #}
  {% if windows|length > 0 %}
    {{ ui.status(c, {x: 290, y: 278, icon: 'window-open-variant', color: c.red,
                     text: 'Open: ' ~ windows|join(', ')|trunc(32)}) }}
  {% else %}
    {{ ui.status(c, {x: 290, y: 278, icon: 'window-closed-variant', color: c.green, text: 'Windows closed'}) }}
  {% endif %}

  {% if d.door_locked == 'True' %}
    {{ ui.status(c, {x: 290, y: 318, icon: 'lock', color: c.black, text: 'Front door locked'}) }}
  {% else %}
    {{ ui.status(c, {x: 290, y: 318, icon: 'lock-open-variant', color: c.red, text: 'Front door UNLOCKED!'}) }}
  {% endif %}

  {# Calendar #}
  {{ ui.list(c, {x: 290, y: 372, w: 494, title: 'Up next', items: d.events is iterable ? d.events : [],
                 max: 2, chars: 30, empty: 'No events'}) }}

  {% if d.bins and d.bins != 'unknown' %}
    {{ ui.badge(c, {x: 544, y: 244, w: 240, bg: c.yellow, text: 'Bins: ' ~ d.bins|trunc(16), size: 18}) }}
  {% endif %}
</svg>
